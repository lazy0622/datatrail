OPENAI_API_KEY=replace-with-your-provider-key
OPENAI_API_BASE=https://api.deepseek.com/v1
LLM_MODEL_PROVIDER=proxy/deepseek
LLM_MODEL_NAME=deepseek-flash
DATATRAIL_GRAIN_GUARD=1
DATATRAIL_QUERY_REUSE=1
